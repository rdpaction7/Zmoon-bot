# ── Upload service (upload-service/) — optional ───────────────────────────────
# The frontend sends the GitHub token with each upload, so the service works with
# no configuration at all. These variables are optional: use them if you would
# rather the token live on the server than in the built frontend.
PORT=10000

# Server-side fallback token (used only when the request has no Authorization header).
# Never commit a real value. Prefer the App.tsx placeholder or the Settings screen.
GITHUB_TOKEN=
GITHUB_OWNER=rdpaction7
GITHUB_REPO=Skillswpa
GITHUB_RELEASE_PREFIX=skillswap-media
# GitHub caps a single release at 1000 assets; the uploader rolls over to the next
# numbered release automatically.
GITHUB_MAX_ASSETS_PER_RELEASE=1000
